{
  "name": "nsl-download",
  "version": "1.0.0",
  "description": "Video downloader browser — browse any site and download detected videos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:universal": "electron-builder --mac --universal"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.nsl.download",
    "productName": "NSL Download",
    "copyright": "Copyright © 2026 NSL",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extraResources": [
        { "from": "bin/", "to": "bin/", "filter": ["**/*"] }
      ]
    },
    "dmg": {
      "title": "NSL Download",
      "window": { "width": 540, "height": 380 }
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!bin/**/*"
    ]
  }
}
