{
  "name": "nsl-downloader",
  "version": "1.0.0",
  "description": "Video downloader browser — browse any site and download detected videos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:universal": "electron-builder --mac --universal",
    "test": "node --test test/*.test.cjs",
    "test:037": "electron scripts/test-037.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lertumpai.downloader",
    "productName": "NSL Downloader",
    "copyright": "Copyright © 2026 NSL Downloader",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extraResources": [
        {
          "from": "bin/",
          "to": "bin/",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "title": "NSL Downloader",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-browser.js",
      "src/**/*",
      "!bin/**/*"
    ]
  }
}
